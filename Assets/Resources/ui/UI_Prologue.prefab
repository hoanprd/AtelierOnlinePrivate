--- !u!114 &114060945828524476
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709867586078768}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 848282c0978acd885155e93949b74925, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  leftAnchor:
    target: {fileID: 0}
    relative: 0
    absolute: 0
  rightAnchor:
    target: {fileID: 0}
    relative: 1
